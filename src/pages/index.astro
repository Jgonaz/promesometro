  }

  /* Comparativa: qué proponen los otros tres partidos sobre lo mismo. */
  .comparativa {
    margin-top: 20px;
  }

  .comparativa-titulo {
    margin: 0 0 12px;
    font-family: var(--fuente-titulo);
    font-size: var(--t-lg);
    font-weight: 700;
  }

  .comparativa-lista {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
