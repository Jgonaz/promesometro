      linear-gradient(to bottom right, transparent 46%, var(--borde) 47% 53%, transparent 54%) left / 50% 100% no-repeat,
      linear-gradient(to bottom left, transparent 46%, var(--borde) 47% 53%, transparent 54%) right / 50% 100% no-repeat;
