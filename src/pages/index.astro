---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { PARTIDOS } from '../lib/partidos';
import cabecera from '../assets/cabecera.png';
import frases from '../data/frases.json';
import fuentes from '../../data/programas/fuentes.json';

const RONDA = 10;
const urls = Object.fromEntries(fuentes.programas.map((p) => [p.partido, p.url]));
const datos = { frases, urls, partidos: PARTIDOS.map(({ nombre, logo, raiz }) => ({ nombre, logo, raiz })) };
---

<Base
  title="Promesómetro · ¿De quién es esta promesa?"
  description="Medidas reales de los programas electorales del 29N, sin siglas. ¿Sabrías decir de qué partido es cada una?"
>
  <main class="app">
    <header class="cabecera">
      <div class="cabecera-texto">
        <h1 class="marca">Promesómetro</h1>
        <p class="lema">
          ¿De quién es esta promesa? Medidas reales de los programas de las generales del
          29&nbsp;de&nbsp;noviembre, sin siglas.
        </p>
      </div>
      <div class="cabecera-lamina">
        <Image
          class="cabecera-ilustracion"
          src={cabecera}
          alt=""
          widths={[320, 560, 840]}
          sizes="280px"
          loading="eager"
          fetchpriority="high"
        />
        <span class="sello-29n" aria-hidden="true">29·N</span>
      </div>
    </header>

    <section id="portada" class="papeleta portada">
      <h2 class="papeleta-titulo">Instrucciones para votar</h2>
      <ol class="instrucciones">
        <li>Te enseñamos <strong>{RONDA} medidas</strong> copiadas literalmente de los programas de <strong>Frente Amplio, PP, PSOE y Vox</strong>.</li>
        <li>Mete cada una en el sobre del partido que creas que la propone.</li>
        <li>Al votar verás la respuesta, la página exacta del programa y qué proponen los demás sobre lo mismo.</li>
      </ol>
      <p class="aviso">Unas se deducen pensando un poco. Otras te van a sorprender.</p>
      <div class="sobres-muestra" aria-hidden="true">
        {
          PARTIDOS.map((p) => (
            <span class="chip-logo" style={`--raiz:${p.raiz}`}>
              <img src={p.logo} alt="" width="80" height="40" />
            </span>
          ))
        }
      </div>
      <div class="acciones">
        <button id="empezar" class="boton-principal">Coger papeleta</button>
        <button id="reto" class="boton-secundario">Reto del día · 5 frases</button>
      </div>
      <p class="enlace-coincidencias">
        ¿Y tú qué harías? <a href="/coincidencias">Descubre con quién coincides →</a>
      </p>
      <p id="partidas" class="partidas" hidden></p>
    </section>

    <section id="juego" class="juego" hidden>
      <div class="estado">
        <ol id="progreso" class="progreso" aria-label="Progreso de la ronda"></ol>
        <span id="marcador" class="marcador">Aciertos: 0</span>
      </div>

      <article id="papeleta" class="papeleta">
        <div class="papeleta-cabecera">
          <span id="contador" class="papeleta-numero"></span>
          <span id="tema" class="papeleta-tema"></span>
        </div>
        <blockquote id="frase" class="frase" tabindex="-1"></blockquote>
        <details id="explicacion" class="explicacion">
          <summary>En otras palabras</summary>
          <p id="explicacion-texto"></p>
        </details>
        <div id="sello" class="sello" aria-hidden="true"></div>
      </article>

      <div class="pregunta-fila">
        <p class="pregunta" id="pregunta">¿En qué sobre la metes?</p>
        <p class="atajos" aria-hidden="true">Teclas <kbd>1</kbd>–<kbd>4</kbd></p>
      </div>
      <div id="opciones" class="opciones" role="group" aria-labelledby="pregunta">
        {
          PARTIDOS.map((p, i) => (
            <button class="sobre" data-partido={p.nombre} aria-label={p.nombre} aria-keyshortcuts={String(i + 1)}>
              <span class="sobre-tecla" aria-hidden="true">{i + 1}</span>
              <span class="chip-logo sobre-logo" style={`--raiz:${p.raiz}`}>
                <img src={p.logo} alt="" width="160" height="80" />
              </span>
              <span class="sobre-nombre">{p.nombre}</span>
            </button>
          ))
        }
      </div>

      <div id="revelacion" class="revelacion" aria-live="polite" hidden>
        <p id="veredicto" class="veredicto"></p>
        <p id="fuente" class="fuente"></p>
        <p id="acierto-global" class="acierto-global" hidden></p>
        <section class="comparativa" aria-labelledby="titulo-comparativa">
          <h3 id="titulo-comparativa" class="comparativa-titulo">¿Y qué proponen los demás?</h3>
          <ul id="comparativa" class="comparativa-lista"></ul>
        </section>
        <button id="siguiente" class="boton-principal">Siguiente papeleta</button>
      </div>
    </section>

    <section id="final" class="papeleta final" hidden aria-labelledby="titulo-final">
      <h2 class="papeleta-titulo" id="titulo-final">Escrutinio</h2>
      <div class="resultado">
        <p class="puntuacion" id="puntuacion" tabindex="-1">
          <span id="aciertos">0</span><span class="de">/<span id="total">{RONDA}</span></span>
          <span class="sr">aciertos</span>
        </p>
        <span id="sello-final" class="sello sello-final" aria-hidden="true"></span>
      </div>
      <ol id="progreso-final" class="progreso progreso-final" aria-label="Tus respuestas"></ol>
      <p id="comentario" class="comentario"></p>
      <section class="retrato" aria-labelledby="titulo-retrato">
        <h3 id="titulo-retrato" class="retrato-titulo">Tu retrato</h3>
        <ul id="retrato" class="retrato-lista"></ul>
      </section>
      <div class="acciones">
        <button id="compartir" class="boton-principal">Compartir resultado</button>
        <button id="otra" class="boton-secundario">Otra ronda</button>
        <button id="reto-final" class="boton-secundario">Reto del día · 5 frases</button>
        <a id="ver-resultados" class="boton-secundario" href="/resultados" hidden>Ver resultados</a>
      </div>
      <p id="aviso-compartir" class="aviso" aria-live="polite" hidden></p>
      <p class="enlace-coincidencias">
        ¿Y tú qué harías? <a href="/coincidencias">Descubre con quién coincides →</a>
      </p>
      <details class="repaso">
        <summary id="titulo-repaso">Repasa tus {RONDA} papeletas</summary>
        <ol id="resumen" class="resumen"></ol>
      </details>
    </section>

    <footer class="pie">
      <p>
        Todas las frases son citas literales de los programas oficiales de las elecciones generales del
        29 de noviembre de 2026; los recortes se marcan con «[…]». Cada respuesta enlaza a su página del
        programa. Las explicaciones «En otras palabras» y los resúmenes de la comparativa son nuestros:
        ante la duda, manda la cita.
      </p>
      <p>
        Proyecto independiente, sin relación con ningún partido. Los logotipos pertenecen a sus
        respectivos partidos y se usan solo para identificarlos. Guardamos tus respuestas de forma
        anónima (sin cookies, IP ni datos personales) para elaborar estadísticas de conjunto.
        <a href="/coincidencias">¿Con quién coincides?</a> ·
        <a href="/metodologia">Cómo hacemos Promesómetro</a>.
      </p>
    </footer>
  </main>

  <script type="application/json" id="datos" set:html={JSON.stringify(datos)} />

  <script>
    import { MIN_PARTIDAS, numero, pedirEstadisticas, porcentaje, presentar, type Estadisticas } from '../lib/cliente';

    // Sin medida sobre el asunto, resumen, texto y paginaPdf llegan a null.
    type Comparacion = { partido: string; resumen: string | null; texto: string | null; paginaPdf: number | null };
    type Frase = {
      id: string;
      partido: string;
      paginaPdf: number;
      texto: string;
      tema: string;
      enOtrasPalabras: string;
      comparativa: Comparacion[];
    };
    type Datos = {
      frases: Frase[];
      urls: Record<string, string>;
      partidos: { nombre: string; logo: string; raiz: string }[];
    };

    // Longitud de cada modo; la partida en curso la conoce por `ronda.length`.
    const LONGITUD = { ronda: 10, reto: 5 } as const;
    type Modo = keyof typeof LONGITUD;
    const datos: Datos = JSON.parse(document.getElementById('datos')!.textContent!);
    const nombres = datos.partidos.map((p) => p.nombre);
    const partidoDe = new Map(datos.partidos.map((p) => [p.nombre, p]));

    // Iconos de acierto y fallo dibujados (no glifos), en el color del texto.
    const ICONO = {
      ok: '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      ko: '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>',
    };

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const portada = $('portada');
    const juego = $('juego');
    const final = $('final');
    const sobres = [...document.querySelectorAll<HTMLButtonElement>('.sobre')];
    let puntos: HTMLElement[] = [];

    let ronda: Frase[] = [];
    let modo: Modo = 'ronda';
    // Fecha (YYYY-MM-DD, Madrid) del reto en curso; se fija al empezar.
    let fechaReto = '';
    let indice = 0;
    let respuestas: { frase: Frase; elegido: string }[] = [];
    let esperandoVoto = false;
    // Analítica anónima: id aleatorio solo en memoria, nuevo en cada ronda.
    let partida = '';
    let abrioExplicacion = false;
    // Frases ya vistas en la sesión, para no repetir hasta agotar todas. Solo
    // cuenta la ronda normal: el reto no las marca, porque su selección debe ser
    // la misma para todos y no puede depender de lo que cada uno haya visto.
    const vistas = new Set<string>();
    // Agregados públicos: se piden una vez y nunca bloquean el juego. Hasta
    // que lleguen (o si fallan) no se enseña nada de ellos.
    let estadisticas: Estadisticas | null = null;

    function barajar<T>(lista: T[], azar: () => number = Math.random): T[] {
      const a = [...lista];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(azar() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    // Ronda equilibrada: 3+3+2+2 frases por partido, priorizando las no vistas.
    // Así nadie acierta por descarte ni por frecuencia.
    function nuevaRonda(): Frase[] {
      if (datos.frases.every((f) => vistas.has(f.id))) vistas.clear();
      const cupos = barajar([3, 3, 2, 2]);
      const elegidas: Frase[] = [];
      nombres.forEach((partido, i) => {
        const delPartido = barajar(datos.frases.filter((f) => f.partido === partido));
        delPartido.sort((a, b) => Number(vistas.has(a.id)) - Number(vistas.has(b.id)));
        elegidas.push(...delPartido.slice(0, cupos[i]));
      });
      return separarTemas(barajar(elegidas));
    }

    // Hash FNV-1a de 32 bits y PRNG mulberry32: pequeños y deterministas, para que
    // el reto de un día dé lo mismo en cualquier dispositivo (sin Math.random).
    function hash(texto: string): number {
      let h = 0x811c9dc5;
      for (let i = 0; i < texto.length; i++) h = Math.imul(h ^ texto.charCodeAt(i), 0x01000193);
      return h >>> 0;
    }

    function mulberry32(semilla: number): () => number {
      let a = semilla;
      return () => {
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // Día natural de Madrid (el reto cambia a las 00:00 peninsulares).
    const hoyEnMadrid = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(new Date());

    // Reto: 2+1+1+1 frases (el partido doble lo elige la semilla), siempre al
    // menos una por partido, sin tener en cuenta las ya vistas.
    function retoDelDia(fecha: string): Frase[] {
      const azar = mulberry32(hash(fecha));
      const doble = Math.floor(azar() * nombres.length);
      const elegidas: Frase[] = [];
      nombres.forEach((partido, i) => {
        const delPartido = barajar(datos.frases.filter((f) => f.partido === partido), azar);
        elegidas.push(...delPartido.slice(0, i === doble ? 2 : 1));
      });
      return separarTemas(barajar(elegidas, azar));
    }

    // Dos papeletas seguidas del mismo tema repiten casi la misma comparativa:
    // se intercambia la segunda con otra de cualquier posición que no cree un
    // choque nuevo. Si ninguna sirve (muy improbable), se queda como está.
    function separarTemas(lista: Frase[]): Frase[] {
      const choca = (i: number, f: Frase) => lista[i - 1]?.tema === f.tema || lista[i + 1]?.tema === f.tema;
      for (let i = 1; i < lista.length; i++) {
        if (lista[i].tema !== lista[i - 1].tema) continue;
        for (let j = 0; j < lista.length; j++) {
          if (j === i || j === i - 1) continue;
          const [a, b] = [lista[i], lista[j]];
          [lista[i], lista[j]] = [b, a];
          if (!choca(i, lista[i]) && !choca(j, lista[j])) break;
          [lista[i], lista[j]] = [a, b];
        }
      }
      return lista;
    }

    // Recorta en el último espacio para no partir palabras.
    function recortar(texto: string, max: number): string {
      if (texto.length <= max) return texto;
      const corte = texto.lastIndexOf(' ', max);
      return `${texto.slice(0, corte > 0 ? corte : max).replace(/[,;:.]$/, '')}…`;
    }

    // «del PP», «del PSOE», «del Frente Amplio», pero «de Vox».
    const del = (p: string) => (p === 'Vox' ? 'de Vox' : `del ${p}`);
    // «al PP», «al PSOE», «al Frente Amplio», pero «a Vox».
    const al = (p: string) => (p === 'Vox' ? 'a Vox' : `al ${p}`);
    const esAcierto = (r: { frase: Frase; elegido: string }) => r.elegido === r.frase.partido;
    const aciertos = () => respuestas.filter(esAcierto).length;

    function mostrar(seccion: HTMLElement) {
      for (const s of [portada, juego, final]) s.hidden = s !== seccion;
    }

    function marcarPunto(li: HTMLElement, n: number, estado: 'ok' | 'ko' | 'actual' | '') {
      li.className = estado;
      const texto = estado === 'ok' ? 'acierto' : estado === 'ko' ? 'fallo' : estado === 'actual' ? 'en curso' : 'pendiente';
      li.innerHTML = `<span class="sr">Papeleta ${n}: ${texto}</span>`;
    }

    function empezar(nuevoModo: Modo) {
      modo = nuevoModo;
      if (modo === 'reto') {
        fechaReto = hoyEnMadrid();
        ronda = retoDelDia(fechaReto);
      } else ronda = nuevaRonda();
      partida = crypto.randomUUID();
      indice = 0;
      respuestas = [];
      $('progreso').setAttribute('aria-label', modo === 'reto' ? 'Progreso del reto' : 'Progreso de la ronda');
      $('progreso').replaceChildren(...ronda.map(() => document.createElement('li')));
      puntos = [...$('progreso').children] as HTMLElement[];
      puntos.forEach((p, i) => marcarPunto(p, i + 1, ''));
      mostrar(juego);
      pintarFrase();
      juego.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function pintarFrase() {
      const f = ronda[indice];
      $('contador').textContent = `Papeleta ${indice + 1}/${ronda.length}`;
      $('marcador').textContent = `Aciertos: ${aciertos()}`;
      $('tema').textContent = f.tema;
      $('frase').textContent = presentar(f.texto);
      $('explicacion-texto').textContent = f.enOtrasPalabras;
      ($('explicacion') as HTMLDetailsElement).open = false;
      abrioExplicacion = false;
      marcarPunto(puntos[indice], indice + 1, 'actual');
      const sello = $('sello');
      sello.className = 'sello';
      sello.textContent = '';
      for (const b of sobres) {
        b.disabled = false;
        b.className = 'sobre';
      }
      $('revelacion').hidden = true;
      esperandoVoto = true;
      // Reinicia la animación de entrada de la papeleta.
      const papeleta = $('papeleta');
      papeleta.classList.remove('entra');
      void papeleta.offsetWidth;
      papeleta.classList.add('entra');
      // El foco va a la medida nueva para que teclado y lector de pantalla no se pierdan.
      $('frase').focus({ preventScroll: true });
    }

    function responder(elegido: string) {
      if (!esperandoVoto) return;
      esperandoVoto = false;
      const f = ronda[indice];
      respuestas.push({ frase: f, elegido });
      if (modo === 'ronda') vistas.add(f.id);
      registrar(f, elegido);
      const ok = elegido === f.partido;

      for (const b of sobres) {
        b.disabled = true;
        if (b.dataset.partido === f.partido) b.classList.add('correcta');
        else if (b.dataset.partido === elegido) b.classList.add('incorrecta');
        else b.classList.add('apagada');
      }
      marcarPunto(puntos[indice], indice + 1, ok ? 'ok' : 'ko');

      const sello = $('sello');
      sello.textContent = ok ? 'Acierto' : 'Fallo';
      sello.className = `sello visible ${ok ? 'ok' : 'ko'}`;

      const veredicto = $('veredicto');
      veredicto.className = `veredicto ${ok ? 'ok' : 'ko'}`;
      veredicto.textContent = ok ? `¡Correcto! Es ${del(f.partido)}.` : `No. Es ${del(f.partido)}.`;

      $('fuente').replaceChildren(
        'Lo dice su programa electoral, en la ',
        Object.assign(document.createElement('a'), {
          href: `${datos.urls[f.partido]}#page=${f.paginaPdf}`,
          target: '_blank',
          rel: 'noopener',
          textContent: `página ${f.paginaPdf} del PDF`,
        }),
        '.',
      );

      // El porcentaje solo existe tras la activación y con respuestas suficientes.
      const global = estadisticas?.frases?.[f.id];
      $('acierto-global').hidden = !global;
      if (global) $('acierto-global').textContent = `El ${porcentaje(global.pct)} de los jugadores acertó esta frase.`;

      pintarComparativa(f);

      $('marcador').textContent = `Aciertos: ${aciertos()}`;
      $('siguiente').textContent = indice === ronda.length - 1 ? 'Ver escrutinio' : 'Siguiente papeleta';
      $('revelacion').hidden = false;
      $('siguiente').focus({ preventScroll: true });
      $('veredicto').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Envío en segundo plano: sin await para no retrasar la revelación, y con
    // keepalive para que llegue aunque se cierre la página. Los fallos se
    // ignoran: el juego nunca depende del registro.
    function registrar(f: Frase, elegido: string) {
      try {
        fetch('/api/respuesta', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ partida, frase: f.id, elegido, posicion: indice + 1, explicacion: abrioExplicacion, modo }),
          keepalive: true,
        }).catch(() => {});
      } catch {}
    }

    // Los otros tres partidos, en el orden alfabético fijo de los sobres.
    function pintarComparativa(f: Frase) {
      const items = nombres
        .filter((n) => n !== f.partido)
        .map((nombre) => {
          const c = f.comparativa.find((x) => x.partido === nombre);
          const p = partidoDe.get(nombre)!;
          const li = document.createElement('li');
          li.className = 'comp';

          const cabecera = document.createElement('div');
          cabecera.className = 'comp-cabecera';
          const chip = document.createElement('span');
          chip.className = 'chip-logo comp-logo';
          chip.style.setProperty('--raiz', p.raiz);
          chip.append(Object.assign(document.createElement('img'), { src: p.logo, alt: '', width: 80, height: 40 }));
          cabecera.append(chip, Object.assign(document.createElement('strong'), { textContent: nombre }));
          li.append(cabecera);

          if (!c?.texto || !c.resumen || !c.paginaPdf) {
            li.append(
              Object.assign(document.createElement('p'), {
                className: 'comp-resumen comp-nada',
                textContent: 'No hemos encontrado medidas sobre esto en su programa.',
              }),
            );
            return li;
          }

          const cita = document.createElement('details');
          cita.className = 'comp-cita';
          cita.append(
            Object.assign(document.createElement('summary'), { textContent: 'Leer la cita' }),
            Object.assign(document.createElement('blockquote'), { textContent: presentar(c.texto) }),
            Object.assign(document.createElement('a'), {
              href: `${datos.urls[nombre]}#page=${c.paginaPdf}`,
              target: '_blank',
              rel: 'noopener',
              textContent: `Página ${c.paginaPdf} de su programa`,
            }),
          );
          li.append(Object.assign(document.createElement('p'), { className: 'comp-resumen', textContent: c.resumen }), cita);
          return li;
        });
      $('comparativa').replaceChildren(...items);
    }

    function siguiente() {
      indice++;
      if (indice < ronda.length) {
        pintarFrase();
        $('papeleta').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else terminar();
    }

    // Título del sello final según la nota, en el lenguaje de la jornada electoral.
    // Los umbrales son proporcionales a la longitud de la partida (9, 7 y 4 de 10).
    function titulo(n: number) {
      const p = n / ronda.length;
      if (p >= 0.9) return 'Lector de programas';
      if (p >= 0.7) return 'Buen ojo';
      if (p >= 0.4) return 'Indeciso';
      return 'Voto en blanco';
    }

    // Retrato de la partida con sus propias respuestas. Los empates se resuelven
    // por orden alfabético de partido: se recorre `nombres` (ya ordenado) y solo
    // desplaza al candidato actual un recuento estrictamente mayor.
    function retrato() {
      const fallos = respuestas.filter((r) => !esAcierto(r));
      let confusion: { elegido: string; real: string; n: number } | null = null;
      let resistido: { partido: string; n: number } | null = null;
      for (const real of nombres) {
        const n = fallos.filter((r) => r.frase.partido === real).length;
        if (n > (resistido?.n ?? 0)) resistido = { partido: real, n };
        for (const elegido of nombres) {
          const c = fallos.filter((r) => r.frase.partido === real && r.elegido === elegido).length;
          if (c > (confusion?.n ?? 0)) confusion = { elegido, real, n: c };
        }
      }
      return { confusion, resistido };
    }

    const medidas = (n: number) => `${n} ${n === 1 ? 'medida' : 'medidas'}`;

    function terminar() {
      const n = aciertos();
      const total = ronda.length;
      const p = n / total;
      $('aciertos').textContent = String(n);
      $('total').textContent = String(total);
      $('titulo-repaso').textContent = `Repasa tus ${total} papeletas`;
      $('comentario').textContent =
        p >= 0.9
          ? 'Te has leído los cuatro programas. Confiesa.'
          : p >= 0.7
            ? 'Muy bien. Pocos distinguen tan bien la letra pequeña.'
            : p >= 0.4
              ? 'Ni tan mal: los programas se parecen más de lo que crees.'
              : 'Tranquilidad: a casi todo el mundo le pasa. Se parecen mucho.';

      const sello = $('sello-final');
      sello.textContent = titulo(n);
      sello.className = `sello sello-final visible ${p >= 0.5 ? 'ok' : 'ko'}`;

      const { confusion, resistido } = retrato();
      const lineas = confusion
        ? [
            `Le diste ${al(confusion.elegido)} ${medidas(confusion.n)} ${del(confusion.real)}.`,
            `El partido que más se te resistió: ${resistido!.partido}.`,
          ]
        : ['No confundiste a ningún partido.'];
      $('retrato').replaceChildren(...lineas.map((t) => Object.assign(document.createElement('li'), { textContent: t })));

      // Desde un reto se ofrece una ronda; desde una ronda, el reto.
      $('otra').textContent = modo === 'reto' ? 'Jugar una ronda' : 'Otra ronda';
      $('reto-final').hidden = modo === 'reto';

      $('progreso-final').replaceChildren(
        ...respuestas.map((r, i) => {
          const li = document.createElement('li');
          marcarPunto(li, i + 1, esAcierto(r) ? 'ok' : 'ko');
          return li;
        }),
      );

      $('resumen').replaceChildren(
        ...respuestas.map((r) => {
          const ok = esAcierto(r);
          const li = document.createElement('li');
          li.className = ok ? 'ok' : 'ko';
          const partido = document.createElement('span');
          partido.className = 'resumen-partido';
          partido.innerHTML = ICONO[ok ? 'ok' : 'ko'];
          partido.append(ok ? ` ${r.frase.partido}` : ` Era ${del(r.frase.partido)} · dijiste ${r.elegido}`);
          li.append(
            Object.assign(document.createElement('span'), {
              className: 'resumen-frase',
              textContent: recortar(presentar(r.frase.texto), 140),
            }),
            partido,
          );
          return li;
        }),
      );

      $('aviso-compartir').hidden = true;
      $('compartir').textContent = 'Compartir resultado';
      mostrar(final);
      final.scrollIntoView({ behavior: 'smooth', block: 'start' });
      $('puntuacion').focus({ preventScroll: true });
    }

    async function compartir() {
      const n = aciertos();
      const total = ronda.length;
      // Símbolos monocromos: los cuadrados de colores evocarían a partidos.
      const casillas = respuestas.map((r) => (esAcierto(r) ? '●' : '○')).join('');
      const cabecera =
        modo === 'reto'
          ? `🗳️ Promesómetro · Reto del ${fechaReto.slice(8)}/${fechaReto.slice(5, 7)}: ${n}/${total}`
          : `🗳️ Promesómetro: ${n}/${total} · ${titulo(n)}`;
      const { confusion } = retrato();
      const lineas = [cabecera, casillas];
      if (confusion) lineas.push(`Le di ${al(confusion.elegido)} ${medidas(confusion.n)} ${del(confusion.real)}.`);
      lineas.push('¿Sabrías de quién es cada promesa del 29N?');
      const texto = lineas.join('\n');
      // El enlace del reto lo abre directamente (ver el arranque al final).
      const url = location.origin + location.pathname + (modo === 'reto' ? '#reto' : '');
      const boton = $('compartir');
      const aviso = $('aviso-compartir');
      try {
        if (navigator.share) {
          await navigator.share({ text: texto, url });
          return;
        }
      } catch (e) {
        // Si la persona cancela el menú de compartir, no hay nada que avisar.
        if ((e as DOMException).name === 'AbortError') return;
      }
      try {
        await navigator.clipboard.writeText(`${texto}\n${url}`);
        boton.textContent = '¡Copiado!';
        setTimeout(() => (boton.textContent = 'Compartir resultado'), 2000);
      } catch {
        aviso.textContent = `No hemos podido copiarlo. Comparte este enlace: ${url}`;
        aviso.hidden = false;
      }
    }

    // Atajos: 1-4 votan; Intro sigue (el foco ya está en «Siguiente»).
    document.addEventListener('keydown', (e) => {
      if (juego.hidden || e.altKey || e.ctrlKey || e.metaKey) return;
      const n = Number(e.key);
      if (esperandoVoto && n >= 1 && n <= sobres.length) {
        e.preventDefault();
        responder(sobres[n - 1].dataset.partido!);
      }
    });

    $('empezar').addEventListener('click', () => empezar('ronda'));
    $('otra').addEventListener('click', () => empezar('ronda'));
    $('reto').addEventListener('click', () => empezar('reto'));
    $('reto-final').addEventListener('click', () => empezar('reto'));
    $('siguiente').addEventListener('click', siguiente);
    $('compartir').addEventListener('click', compartir);
    $('explicacion').addEventListener('toggle', (e) => {
      if ((e.target as HTMLDetailsElement).open && esperandoVoto) abrioExplicacion = true;
    });
    for (const b of sobres) b.addEventListener('click', () => responder(b.dataset.partido!));

    // El enlace compartido del reto abre el reto directamente.
    if (location.hash === '#reto') empezar('reto');

    pedirEstadisticas().then((e) => {
      estadisticas = e;
      if (!e) return;
      if (e.partidas >= MIN_PARTIDAS) {
        $('partidas').textContent = `${numero(e.partidas)} partidas jugadas`;
        $('partidas').hidden = false;
      }
      // Solo hay frases tras la activación: antes de ella no se enlaza a resultados.
      $('ver-resultados').hidden = !e.frases;
    });
  </script>
</Base>

<style>
  .app {
    max-width: 680px;
