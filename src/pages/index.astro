  .cabecera-ilustracion {
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    /* Funde los bordes de la ilustración con el papel del fondo. */
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at center, #000 70%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at center, #000 70%, transparent 100%);
  }

  @media (prefers-color-scheme: dark) {
    .cabecera-ilustracion {
      mix-blend-mode: normal;
      -webkit-mask-image: none;
      mask-image: none;
      border-radius: 10px;
      transform: rotate(2deg);
      box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.7);
    }
  }

  .sello-29n {
    position: absolute;
    top: -6px;
    right: -6px;
    padding: 2px 10px;
    border: 2px solid var(--lacre);
    border-radius: 4px;
    background: var(--papel);
    color: var(--lacre);
    font-family: var(--fuente-titulo);
    font-weight: 800;
    font-size: var(--t-sm);
    letter-spacing: 0.06em;
